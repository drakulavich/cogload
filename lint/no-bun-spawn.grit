language js

or {
  `Bun.spawn`,
  `Bun.spawnSync`,
  `Bun.$`,
  `import $_ from "bun"`,
  `import $_ from "node:child_process"`,
  `import $_ from "child_process"`
} as $call where {
  register_diagnostic(
    span = $call,
    message = "A program cogload starts dies with cogload. Start it through startInBackground in src/lib/card/image.io.ts, which runs it under sh with SIGHUP ignored.",
    severity = "error"
  )
}
