{
  "name": "@drakulavich/cogload",
  "version": "0.12.1",
  "description": "Keep your head cold. A thermometer for your Claude Code days: every hour scored 0 to 100 from the transcripts already on your disk. Nothing leaves your machine.",
  "license": "MIT",
  "author": "Anton Yakutovich",
  "repository": { "type": "git", "url": "git+https://github.com/drakulavich/cogload.git" },
  "homepage": "https://github.com/drakulavich/cogload#readme",
  "bugs": "https://github.com/drakulavich/cogload/issues",
  "keywords": ["claude-code", "cognitive-load", "developer-experience", "cli", "bun"],
  "type": "module",
  "bin": { "cogload": "src/cli/index.ts", "zapara": "src/cli/zapara.ts" },
  "files": ["src/", "assets/fonts/", "assets/characters.webp", "CHANGELOG.md", "!src/**/*.test.ts"],
  "publishConfig": { "access": "public" },
  "engines": { "bun": ">=1.4.2" },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "stats": "bun scripts/signal-stats.ts",
    "test": "TZ=UTC bun test ./tests",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci && knip --include files,exports,types",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.0",
    "knip": "^6.38.0",
    "typescript": "^7.0.2"
  }
}
